# Database Settings
DB_URL=jdbc:mysql://localhost:3306/phone_store?useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Settings
# Secret must be at least 256 bits (32 chars) for HS256
JWT_SECRET=your_jwt_secret_must_be_long_enough_for_hs256_replace_this
JWT_EXPIRATION_MS=3600000

# Spring Settings
SPRING_PROFILES_ACTIVE=dev

# Mail Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
